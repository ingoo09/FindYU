# FindYU 백엔드 환경변수 예시
# 이 파일을 복사해 backend/.env로 저장한 뒤 값을 채우세요:  cp .env.example .env
# .env는 .gitignore에 포함되어 있으므로 API 키가 커밋되지 않습니다.
# (셸에 이미 설정된 환경변수가 .env보다 우선합니다)

# ---------------------------------------------------------
# 등록 분석 (습득물 사진 → 품명/색상/기종 등)
# ---------------------------------------------------------
# mock   : 모델 없이 고정 결과 (개발·테스트용)
# vlm    : 로컬 SmolVLM (기종·확신도 미지원)
# gemini : Gemini API 직접 호출 + prompts/identify_item_v1.2.md
# baze   : 학교 팩트챗(마인드로직 BAZE API Gateway)으로 Gemini 호출 (기본값)
#          프롬프트·응답 스키마·DB 저장 방식은 gemini 모드와 같음
FINDYU_REGISTRATION_ANALYZER_MODE=baze

# 팩트챗(BAZE) API 키. baze 모드에서 비어 있으면 서버는 뜨지만 분석 요청이 503 에러로 실패합니다.
BAZE_API_KEY=
# 게이트웨이 주소와 모델 (비워 두면 아래 기본값)
# FINDYU_BAZE_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
# 명세(docs/spec/00_공통.md): 개발·테스트 gemini-3.8-flash, 실사용 gemini-4-argon
FINDYU_BAZE_MODEL=gemini-3.8-flash
# 코드 기본값(이 줄을 지우거나 비우면 사용)은 아직 gemini-3.5-flash (AI 담당에 변경 요청함, docs/REQUESTS.md)
# FINDYU_BAZE_MODEL=gemini-3.5-flash
# 요청당 제한 시간(초). 408/429/5xx·네트워크 오류는 최대 3회까지 자동 재시도
# FINDYU_BAZE_TIMEOUT=120

# Google AI Studio(https://aistudio.google.com/apikey)에서 발급
# gemini 모드에서 비어 있으면 서버는 뜨지만 분석 요청이 503 에러로 실패합니다.
GEMINI_API_KEY=

# 사용할 Gemini 모델명. 비워 두면 gemini-3.5-flash (비교 결과: docs/model_comparison.md)
# gemini-3.8-flash는 측면 사진 판별이 더 좋았지만 느리고 504/할당량 초과가 잦았음
# 2026-11-16 확인: gemini-2.5-flash는 신규 사용자 사용 불가(404),
#                  gemini-3.8-flash는 응답 시간 초과(504)로 사용 불가였음
FINDYU_GEMINI_MODEL=gemini-3.5-flash

# Gemini 요청당 제한 시간(초). 429/5xx는 SDK가 최대 3회까지 자동 재시도
FINDYU_GEMINI_TIMEOUT=60

# vlm 모드에서 사용할 로컬 모델
# FINDYU_VLM_MODEL=HuggingFaceTB/SmolVLM-500M-Instruct

# ---------------------------------------------------------
# 검색
# ---------------------------------------------------------
# 검색 방식
# baze : 게이트웨이 사진 임베딩(gemini-embedding-2) + 검색 비교 어댑터(AI 담당 search_analyzer.py) (기본)
# mock : API 호출 없음 (개발·테스트). search_analyzer.py가 생기기 전에는 mock으로 실행
# local: 기존 로컬 모델(DINOv2·SigLIP2·Qwen) 검색
FINDYU_SEARCH_ANALYZER_MODE=mock
# 사진 검색 임베딩 (baze 모드). 비워 두면 아래 기본값
# FINDYU_EMBEDDING_MODEL=gemini-embedding-2
# FINDYU_EMBEDDING_DIMENSIONS=256

# (local 모드 전용) 자연어 검색어 해석: mock(원문 그대로) | llm(로컬 Qwen)
FINDYU_QUERY_PARSER_MODE=llm
# FINDYU_QUERY_LLM_MODEL=Qwen/Qwen3-0.6B

# 이미지 임베딩 모델
# FINDYU_IMAGE_MODEL=facebook/dinov2-small
# FINDYU_TEXT_IMAGE_MODEL=google/siglip2-base-patch16-224
