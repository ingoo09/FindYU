# FindYU 백엔드 환경변수 예시
# 이 파일을 복사해 backend/.env로 저장한 뒤 값을 채우세요:  cp .env.example .env
# .env는 .gitignore에 포함되어 있으므로 API 키가 커밋되지 않습니다.
# (셸에 이미 설정된 환경변수가 .env보다 우선합니다)

# ---------------------------------------------------------
# 등록 분석 (습득물 사진 → 품명/색상/기종 등)
# ---------------------------------------------------------
# mock   : 모델 없이 고정 결과 (개발·테스트용)
# vlm    : 로컬 SmolVLM (기종·확신도 미지원)
# gemini : Gemini API + prompts/identify_item_v1.1.md
FINDYU_REGISTRATION_ANALYZER_MODE=gemini

# Google AI Studio(https://aistudio.google.com/apikey)에서 발급
# gemini 모드에서 비어 있으면 서버는 뜨지만 분석 요청이 503 에러로 실패합니다.
GEMINI_API_KEY=

# 사용할 Gemini 모델명 (필수). AI Studio에서 현재 사용 가능한 모델명을 확인하세요.
# 2026-11-16 확인: gemini-2.5-flash는 신규 사용자 사용 불가(404),
#                  gemini-3.8-flash는 응답 시간 초과(504)로 사용 불가였음
FINDYU_GEMINI_MODEL=gemini-3.5-flash

# Gemini 요청당 제한 시간(초). 429/5xx는 SDK가 최대 3회까지 자동 재시도
FINDYU_GEMINI_TIMEOUT=60

# vlm 모드에서 사용할 로컬 모델
# FINDYU_VLM_MODEL=HuggingFaceTB/SmolVLM-500M-Instruct

# ---------------------------------------------------------
# 검색
# ---------------------------------------------------------
# 자연어 검색어 해석: mock(원문 그대로) | llm(로컬 Qwen)
FINDYU_QUERY_PARSER_MODE=llm
# FINDYU_QUERY_LLM_MODEL=Qwen/Qwen3-0.6B

# 이미지 임베딩 모델
# FINDYU_IMAGE_MODEL=facebook/dinov2-small
# FINDYU_TEXT_IMAGE_MODEL=google/siglip2-base-patch16-224
